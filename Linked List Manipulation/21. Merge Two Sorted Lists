public class Main {

    // Complete definition of one linked-list node
    static class ListNode {
        int val;
        ListNode next;

        ListNode() {
        }

        ListNode(int val) {
            this.val = val;
        }

        ListNode(int val, ListNode next) {
            this.val = val;
            this.next = next;
        }
    }

    static class Solution {

        public ListNode mergeTwoLists(ListNode list1, ListNode list2) {

            // Temporary starting node.
            // It helps us build the answer without separately handling
            // the first node of the merged list.
            ListNode dummy = new ListNode(0);

            // current will move forward and attach nodes.
            // Initially, dummy and current point to the same node.
            ListNode current = dummy;

            // Continue until one of the lists becomes empty.
            while (list1 != null && list2 != null) {

                // Attach the smaller node to the merged list.
                if (list1.val <= list2.val) {

                    // Connect list1's current node after current.
                    current.next = list1;

                    // Move list1 forward because this node has been used.
                    list1 = list1.next;

                } else {

                    // Connect list2's current node after current.
                    current.next = list2;

                    // Move list2 forward because this node has been used.
                    list2 = list2.next;
                }

                // Move current to the node that was just attached.
                current = current.next;
            }

            // After the loop, one list may still contain nodes.
            // Attach that complete remaining list.
            if (list1 != null) {
                current.next = list1;
            } else {
                current.next = list2;
            }

            // Skip the temporary dummy node and return
            // the actual beginning of the merged list.
            return dummy.next;
        }
    }

    // Helper method for printing a linked list
    static void printList(ListNode head) {
        ListNode current = head;

        while (current != null) {
            System.out.print(current.val);

            if (current.next != null) {
                System.out.print(" -> ");
            }

            current = current.next;
        }

        System.out.println();
    }

    public static void main(String[] args) {

        // Creating list1: 1 -> 3 -> 5
        ListNode list1 = new ListNode(1);
        list1.next = new ListNode(3);
        list1.next.next = new ListNode(5);

        // Creating list2: 2 -> 4 -> 6
        ListNode list2 = new ListNode(2);
        list2.next = new ListNode(4);
        list2.next.next = new ListNode(6);

        Solution solution = new Solution();

        // Merge both sorted linked lists
        ListNode mergedList = solution.mergeTwoLists(list1, list2);

        // Print the final merged list
        printList(mergedList);
    }
}
