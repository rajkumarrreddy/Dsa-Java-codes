/**
 * Definition for singly-linked list.
 *
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *
 *     ListNode() {}
 *
 *     ListNode(int val) {
 *         this.val = val;
 *     }
 *
 *     ListNode(int val, ListNode next) {
 *         this.val = val;
 *         this.next = next;
 *     }
 * }
 */

class Solution {

    public ListNode reverseBetween(ListNode head, int left, int right) {

        /*
         * If the list is empty, there is nothing to reverse.
         *
         * If left == right, the reversal section contains only one node,
         * so the list will remain unchanged.
         */
        if (head == null || left == right) {
            return head;
        }

        /*
         * Create a dummy node and place it before the original head.
         *
         * Example:
         *
         * Original:
         * 1 -> 2 -> 3 -> 4 -> 5
         *
         * After adding dummy:
         * 0 -> 1 -> 2 -> 3 -> 4 -> 5
         *
         * The dummy node helps us handle the situation where left = 1.
         * In that case, the original head may change after reversal.
         */
        ListNode dummy = new ListNode(0, head);

        /*
         * prev must eventually point to the node immediately before
         * the portion that needs to be reversed.
         *
         * Initially, prev starts at dummy.
         */
        ListNode prev = dummy;

        /*
         * Move prev left - 1 times.
         *
         * Example:
         *
         * List:
         * 0 -> 1 -> 2 -> 3 -> 4 -> 5
         *
         * left = 2
         *
         * prev should stop at node 1 because node 1 is immediately
         * before position 2.
         *
         * The loop starts from i = 1 and continues while i < left.
         */
        for (int i = 1; i < left; i++) {
            prev = prev.next;
        }

        /*
         * curr points to the first node inside the reversal section.
         *
         * Example:
         *
         * left = 2
         *
         * 0 -> 1 -> 2 -> 3 -> 4 -> 5
         *      ↑    ↑
         *     prev curr
         */
        ListNode curr = prev.next;

        /*
         * The section from left to right contains:
         *
         * right - left + 1 nodes
         *
         * But the first node, curr, is already in the section.
         * Therefore, we need to move only:
         *
         * right - left nodes
         *
         * Example:
         *
         * left = 2, right = 4
         *
         * Nodes to reverse: 2, 3, 4
         *
         * We move node 3 to the front.
         * Then we move node 4 to the front.
         *
         * Total movements = 4 - 2 = 2
         */
        for (int i = 0; i < right - left; i++) {

            /*
             * Select the node immediately after curr.
             *
             * Example:
             *
             * 1 -> 2 -> 3 -> 4 -> 5
             *      ↑    ↑
             *     curr next
             *
             * Here, curr is node 2 and next is node 3.
             *
             * Node 3 will be removed and inserted immediately after prev.
             */
            ListNode next = curr.next;

            /*
             * Remove next from its current position.
             *
             * Before:
             *
             * curr
             *  ↓
             *  2 -> 3 -> 4
             *       ↑
             *      next
             *
             * next.next is node 4.
             *
             * Therefore:
             *
             * curr.next = next.next
             *
             * means:
             *
             * node2.next = node4
             *
             * After removing node 3:
             *
             * 2 -> 4
             *
             * We do not lose node 3 because the next variable
             * is still pointing to it.
             */
            curr.next = next.next;

            /*
             * Make the removed node point to the current first node
             * of the reversal section.
             *
             * prev.next currently points to node 2.
             *
             * next is node 3.
             *
             * Therefore:
             *
             * next.next = prev.next
             *
             * means:
             *
             * node3.next = node2
             *
             * Now we have:
             *
             * 3 -> 2 -> 4
             */
            next.next = prev.next;

            /*
             * Connect prev to the node that we moved.
             *
             * prev is node 1.
             * next is node 3.
             *
             * Therefore:
             *
             * prev.next = next
             *
             * means:
             *
             * node1.next = node3
             *
             * The list becomes:
             *
             * 1 -> 3 -> 2 -> 4 -> 5
             */
            prev.next = next;
        }

        /*
         * Return dummy.next instead of dummy.
         *
         * dummy is the temporary node containing 0:
         *
         * 0 -> 1 -> 4 -> 3 -> 2 -> 5
         *
         * dummy.next points to the actual first node:
         *
         * 1 -> 4 -> 3 -> 2 -> 5
         */
        return dummy.next;
    }
}
