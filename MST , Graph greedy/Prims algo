# 7. Complete Java Code

```java
import java.util.*;

public class PrimMST {

    public static int findMST(
        int numberOfNodes,
        int[][] edges
    ) {

        /*
         * Create an adjacency list.
         *
         * graph.get(node) will contain all neighbors
         * directly connected to that node.
         *
         * Each neighbor is stored as:
         *
         * {neighborNode, edgeWeight}
         */
        List<List<int[]>> graph = new ArrayList<>();

        /*
         * Create one empty neighbor list for every node.
         */
        for (int node = 0; node < numberOfNodes; node++) {
            graph.add(new ArrayList<>());
        }

        /*
         * Build the adjacency list from the given edges.
         *
         * Every edge is represented as:
         *
         * {node1, node2, weight}
         */
        for (int[] edge : edges) {

            int node1 = edge[0];
            int node2 = edge[1];
            int weight = edge[2];

            /*
             * The graph is undirected.
             *
             * Therefore, if node1 is connected to node2,
             * node2 is also connected to node1.
             */
            graph.get(node1).add(
                new int[]{node2, weight}
            );

            graph.get(node2).add(
                new int[]{node1, weight}
            );
        }

        /*
         * Each heap entry contains:
         *
         * {edgeWeight, currentNode, parentNode}
         *
         * The heap is sorted by edgeWeight.
         */
        PriorityQueue<int[]> minHeap =
            new PriorityQueue<>(
                (entry1, entry2) ->
                    Integer.compare(entry1[0], entry2[0])
            );

        /*
         * visited[node] tells us whether the node
         * has already been included in the MST.
         */
        boolean[] visited = new boolean[numberOfNodes];

        /*
         * Begin Prim's algorithm from node 0.
         *
         * Starting entry:
         *
         * edgeWeight  = 0
         * currentNode = 0
         * parentNode  = -1
         *
         * Cost is 0 because no edge is required to
         * include the starting node.
         *
         * Parent is -1 because the starting node
         * does not have a parent.
         */
        minHeap.offer(new int[]{0, 0, -1});

        int totalCost = 0;
        int visitedNodes = 0;

        System.out.println("Selected MST edges:");

        /*
         * Continue while there are available connections.
         */
        while (!minHeap.isEmpty()) {

            /*
             * Remove the cheapest available connection.
             */
            int[] current = minHeap.poll();

            int edgeWeight = current[0];
            int currentNode = current[1];
            int parentNode = current[2];

            /*
             * A node may appear in the heap multiple times.
             *
             * If it has already been included in the MST,
             * this heap entry is stale and must be skipped.
             */
            if (visited[currentNode]) {
                continue;
            }

            /*
             * This is the cheapest available edge that
             * connects currentNode to the existing MST.
             *
             * Therefore, include currentNode in the MST.
             */
            visited[currentNode] = true;

            /*
             * Add the connection cost to the result.
             *
             * For the starting node, edgeWeight is 0.
             */
            totalCost += edgeWeight;

            /*
             * Count how many nodes have joined the MST.
             */
            visitedNodes++;

            /*
             * The starting node has parent -1.
             *
             * Therefore, it does not represent a real edge
             * and should not be printed.
             */
            if (parentNode != -1) {
                System.out.println(
                    parentNode + " -- " +
                    currentNode + " = " +
                    edgeWeight
                );
            }

            /*
             * Explore every neighbor of currentNode.
             */
            for (int[] neighbor : graph.get(currentNode)) {

                int nextNode = neighbor[0];
                int nextWeight = neighbor[1];

                /*
                 * Add this edge to the heap only when
                 * nextNode has not yet joined the MST.
                 *
                 * We do not mark nextNode as visited here.
                 *
                 * A node becomes visited only when it is
                 * removed from the heap using its cheapest
                 * available connection.
                 */
                if (!visited[nextNode]) {

                    minHeap.offer(
                        new int[]{
                            nextWeight,
                            nextNode,
                            currentNode
                        }
                    );
                }
            }
        }

        /*
         * If some nodes were not visited, the graph
         * was disconnected.
         *
         * Therefore, a single MST cannot be formed.
         */
        if (visitedNodes != numberOfNodes) {
            return -1;
        }

        return totalCost;
    }

    public static void main(String[] args) {

        int numberOfNodes = 4;

        /*
         * Every edge is represented as:
         *
         * {node1, node2, weight}
         */
        int[][] edges = {
      *     {0, 1, 1},
            {0, 2,*4},
            {1, 2, 2},
       *    {1, 3, 5},
            {2, 3, *}
        };

        int minimumC*st = findMST(
            numberOf*odes,
            edges
        );*
        System.out.println(
     *      "Minimum spanning tree cost:*" + minimumCost
        );
    }
}*```

