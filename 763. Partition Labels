import java.util.*;

class Solution {

    public List<Integer> partitionLabels(String s) {

        /*
         * STEP 1: Store the last occurrence of every character.
         *
         * Key   = character
         * Value = last index where that character appears
         *
         * Example: "abaccb"
         *
         * a -> 2
         * b -> 5
         * c -> 4
         */
        Map<Character, Integer> lastOccurrence = new HashMap<>();


        // Traverse the string and record the last index of every character
        for (int i = 0; i < s.length(); i++) {

            char currentCharacter = s.charAt(i);

            /*
             * put() replaces the previous index if the character
             * is already present.
             *
             * Therefore, after the loop, the map automatically
             * contains the last occurrence of each character.
             */
            lastOccurrence.put(currentCharacter, i);
        }


        // This list stores the length of every completed partition
        List<Integer> result = new ArrayList<>();


        /*
         * Stores the ending index of the previous partition.
         *
         * Initially, no partition exists, so we use -1.
         *
         * If the first partition ends at index 5:
         *
         * size = 5 - (-1) = 6
         */
        int previousPartitionEnd = -1;


        /*
         * Stores the farthest last occurrence of all the characters
         * encountered inside the current partition.
         *
         * In simple words:
         * "The current partition must travel at least until this index."
         */
        int currentPartitionEnd = 0;


        /*
         * STEP 2: Traverse the string again and determine
         * where each partition should end.
         */
        for (int i = 0; i < s.length(); i++) {

            // Get the character at the current index
            char currentCharacter = s.charAt(i);


            /*
             * Find the last occurrence of the current character.
             *
             * If this character appears farther than our existing
             * partition boundary, extend the current partition.
             *
             * Example:
             *
             * Existing boundary = 2
             * Current character's last occurrence = 5
             *
             * New boundary = Math.max(2, 5) = 5
             */
            currentPartitionEnd = Math.max(
                currentPartitionEnd,
                lastOccurrence.get(currentCharacter)
            );


            /*
             * If the current index reaches the partition boundary,
             * every character encountered in this partition has
             * completed all its occurrences.
             *
             * Therefore, it is safe to cut the partition here.
             */
            if (i == currentPartitionEnd) {

                /*
                 * Calculate the current partition's length.
                 *
                 * First partition:
                 * current end = 5
                 * previous end = -1
                 * length = 5 - (-1) = 6
                 *
                 * Next partition:
                 * current end = 11
                 * previous end = 5
                 * length = 11 - 5 = 6
                 */
                int partitionLength =
                    currentPartitionEnd - previousPartitionEnd;

                // Store the partition length in the answer
                result.add(partitionLength);


                /*
                 * The current partition is now completed.
                 * Save its ending index so that we can calculate
                 * the length of the next partition.
                 */
                previousPartitionEnd = currentPartitionEnd;
            }
        }


        // Return all partition lengths
        return result;
    }
}
