/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *
 *     TreeNode() {}
 *
 *     TreeNode(int val) {
 *         this.val = val;
 *     }
 *
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

class Solution {

    public int maxDepth(TreeNode root) {

        // Base Case
        // If we reach beyond a leaf node,
        // we are standing on an empty tree.
        // Empty tree contributes depth = 0.
        if (root == null) {
            return 0;
        }

        // Ask the left subtree:
        // "What is your maximum depth?"
        int leftHeight = maxDepth(root.left);

        // Ask the right subtree:
        // "What is your maximum depth?"
        int rightHeight = maxDepth(root.right);

        // Current node's depth =
        // 1 (count myself)
        // +
        // whichever subtree is deeper.
        return 1 + Math.max(leftHeight, rightHeight);
    }
}
