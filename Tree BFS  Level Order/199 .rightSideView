import java.util.ArrayDeque;
import java.util.ArrayList;
import java.util.List;
import java.util.Queue;

/**
 * Definition for a binary tree node.
 *
 * LeetCode already provides this TreeNode class.
 * Therefore, keep it as a comment when submitting the solution.
 *
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *
 *     TreeNode() {
 *     }
 *
 *     TreeNode(int val) {
 *         this.val = val;
 *     }
 *
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

class Solution {

    public List<Integer> rightSideView(TreeNode root) {

        /*
         * This list stores the nodes that are visible
         * when we look at the binary tree from the right side.
         *
         * Example:
         *
         *              1
         *            /   \
         *           2     3
         *            \     \
         *             5     4
         *
         * From the right side, we can see:
         *
         * Level 0 → 1
         * Level 1 → 3
         * Level 2 → 4
         *
         * Final answer = [1, 3, 4]
         */
        List<Integer> result = new ArrayList<>();

        /*
         * Edge case:
         *
         * If root is null, the tree is empty.
         * Therefore, no nodes are visible from the right side.
         */
        if (root == null) {
            return result;
        }

        /*
         * BFS uses a queue because a queue follows FIFO:
         *
         * First In, First Out
         *
         * The queue helps us process the tree level by level.
         */
        Queue<TreeNode> queue = new ArrayDeque<>();

        /*
         * Add the root node to begin BFS.
         *
         * Initially, the queue contains only the root.
         */
        queue.offer(root);

        /*
         * Continue until every node has been processed.
         *
         * Each iteration of this while loop processes
         * one complete level of the tree.
         */
        while (!queue.isEmpty()) {

            /*
             * At this moment, the queue contains exactly
             * the nodes that belong to the current level.
             *
             * Store the size before processing the level because
             * children added below belong to the next level.
             */
            int levelSize = queue.size();

            /*
             * Process every node in the current level.
             *
             * Since left children are added before right children,
             * nodes are processed from left to right.
             *
             * Therefore, the node at index levelSize - 1
             * is the last node of the current level.
             */
            for (int i = 0; i < levelSize; i++) {

                /*
                 * Remove the node waiting at the front
                 * of the queue.
                 */
                TreeNode currentNode = queue.poll();

                /*
                 * The final node processed in the current level
                 * is the rightmost node of that level.
                 *
                 * Suppose the level contains:
                 *
                 * [2, 3, 4]
                 *
                 * levelSize = 3
                 *
                 * Indices:
                 * 2 → i = 0
                 * 3 → i = 1
                 * 4 → i = 2
                 *
                 * levelSize - 1 = 2
                 *
                 * Therefore, node 4 is added to the answer.
                 */
                if (i == levelSize - 1) {
                    result.add(currentNode.val);
                }

                /*
                 * If the current node has a left child,
                 * add it to the back of the queue.
                 *
                 * This child belongs to the next level.
                 */
                if (currentNode.left != null) {
                    queue.offer(currentNode.left);
                }

                /*
                 * If the current node has a right child,
                 * add it to the back of the queue.
                 *
                 * This child also belongs to the next level.
                 */
                if (currentNode.right != null) {
                    queue.offer(currentNode.right);
                }
            }
        }

        /*
         * All levels have now been processed.
         *
         * The result contains the rightmost node
         * from every level.
         *
         * THIS IS THE FINAL RETURN STATEMENT.
         */
        return result;
    }
}
