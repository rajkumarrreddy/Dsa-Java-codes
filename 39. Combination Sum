import java.util.ArrayList;
import java.util.List;

class Solution {

    public List<List<Integer>> combinationSum(
            int[] candidates,
            int target
    ) {

        // Stores all valid combinations whose sum equals target.
        //
        // Example:
        // candidates = [2,3,6,7], target = 7
        //
        // result = [
        //     [2,2,3],
        //     [7]
        // ]
        List<List<Integer>> result = new ArrayList<>();

        // Stores the combination we are currently building.
        //
        // Example:
        // [] -> [2] -> [2,2] -> [2,2,3]
        List<Integer> curr = new ArrayList<>();

        /*
         * Start backtracking:
         *
         * start = 0
         * We can begin choosing numbers from index 0.
         *
         * target represents the remaining amount
         * that we still need to form.
         */
        backtrack(0, candidates, target, curr, result);

        return result;
    }

    private void backtrack(
            int start,
            int[] candidates,
            int remaining,
            List<Integer> curr,
            List<List<Integer>> result
    ) {

        /*
         * SUCCESS BASE CASE:
         *
         * If remaining becomes 0, the numbers inside curr
         * add up exactly to the original target.
         *
         * Example:
         *
         * target = 7
         * curr = [2,2,3]
         *
         * remaining:
         * 7 -> 5 -> 3 -> 0
         *
         * Therefore, [2,2,3] is a valid answer.
         */
        if (remaining == 0) {

            /*
             * Save a copy of curr.
             *
             * We need a copy because curr will continue changing
             * during backtracking.
             */
            result.add(new ArrayList<>(curr));

            // This combination is complete.
            // Stop exploring this path.
            return;
        }

        /*
         * Try every candidate from "start" onward.
         *
         * We use start because combinations do not care about order.
         *
         * For example:
         *
         * [2,3,2] and [2,2,3]
         *
         * contain the same numbers, so they should not both appear.
         *
         * Moving only forward prevents reordered duplicates.
         */
        for (int i = start; i < candidates.length; i++) {

            /*
             * If the current number is greater than the remaining
             * target, choosing it would make the remaining value
             * negative.
             *
             * Example:
             *
             * remaining = 1
             * candidates[i] = 2
             *
             * 1 - 2 = -1
             *
             * Therefore, this choice cannot create a valid answer.
             */
            if (candidates[i] > remaining) {
                continue;
            }

            /*
             * CHOOSE:
             *
             * Add the current number to our combination.
             *
             * Example:
             *
             * curr = [2,2]
             * candidates[i] = 3
             *
             * After adding:
             * curr = [2,2,3]
             */
            curr.add(candidates[i]);

            /*
             * EXPLORE:
             *
             * Reduce remaining by the number we just selected.
             *
             * Important:
             * We pass "i", not "i + 1".
             *
             * Passing i means that the same number can be
             * selected again.
             *
             * Example:
             *
             * candidates[i] = 2
             *
             * [] -> [2] -> [2,2] -> [2,2,2]
             *
             * The problem allows us to reuse a candidate
             * an unlimited number of times.
             */
            backtrack(
                    i,
                    candidates,
                    remaining - candidates[i],
                    curr,
                    result
            );

            /*
             * UNDO:
             *
             * Remove the number we just selected.
             *
             * Example:
             *
             * curr = [2,2,3]
             *
             * After removing 3:
             * curr = [2,2]
             *
             * Now the loop can try a different candidate
             * for the same position.
             */
            curr.remove(curr.size() - 1);
        }
    }
}
