class Solution {

    /*
     * parent[node] stores the parent of that node.
     *
     * If parent[node] == node, then the node is the root
     * or leader of its connected component.
     *
     * Example:
     *
     * parent[3] = 1
     *
     * This means node 3 belongs to a component whose parent
     * chain eventually leads toward node 1.
     */
    private int[] parent;

    /*
     * rank[root] represents the approximate height of the DSU tree
     * whose leader is root.
     *
     * Rank helps us attach the shorter tree below the taller tree,
     * which keeps the DSU structure efficient.
     */
    private int[] rank;

    public int[] findRedundantConnection(int[][] edges) {

        /*
         * For this problem:
         *
         * Number of edges = number of nodes.
         *
         * Nodes are numbered from 1 to n.
         */
        int n = edges.length;

        /*
         * We create arrays of size n + 1 because nodes use
         * 1-based numbering.
         *
         * Index 0 will not be used.
         */
        parent = new int[n + 1];
        rank = new int[n + 1];

        /*
         * Initially, no nodes are connected.
         *
         * Therefore, every node starts as the root of its
         * own separate connected component.
         *
         * For n = 5:
         *
         * parent[1] = 1
         * parent[2] = 2
         * parent[3] = 3
         * parent[4] = 4
         * parent[5] = 5
         *
         * Components:
         *
         * {1} {2} {3} {4} {5}
         */
        for (int node = 1; node <= n; node++) {
            parent[node] = node;
        }

        /*
         * Process each edge in the same order given in the input.
         *
         * Every edge contains two connected nodes:
         *
         * edge[0] = first node
         * edge[1] = second node
         */
        for (int[] edge : edges) {

            int node1 = edge[0];
            int node2 = edge[1];

            /*
             * Try to join node1 and node2.
             *
             * union() returns:
             *
             * true:
             * The nodes belonged to different components,
             * so they were successfully connected.
             *
             * false:
             * The nodes already belonged to the same component.
             * This means a path already existed between them.
             * Adding this edge creates a cycle.
             *
             * Therefore, this is the redundant edge.
             */
            if (!union(node1, node2)) {
                return edge;
            }
        }

        /*
         * The problem guarantees that a redundant edge exists,
         * so execution should normally never reach this line.
         */
        return new int[0];
    }

    /*
     * Finds the final root or leader of a node's component.
     *
     * Example:
     *
     * parent[4] = 3
     * parent[3] = 1
     * parent[1] = 1
     *
     * The chain is:
     *
     * 4 -> 3 -> 1
     *
     * Therefore:
     *
     * find(4) returns 1
     */
    private int find(int node) {

        /*
         * If parent[node] == node, then node is already the root.
         *
         * If parent[node] != node, we recursively move upward
         * through the parent chain until the final root is found.
         */
        if (parent[node] != node) {

            /*
             * Path compression:
             *
             * Once we find the final root, directly connect the
             * current node to that root.
             *
             * Before:
             *
             * 4 -> 3 -> 1
             *
             * After find(4):
             *
             * 4 ------> 1
             * 3 ------> 1
             *
             * This makes future find() operations faster.
             */
            parent[node] = find(parent[node]);
        }

        /*
         * Return the final root of the component.
         */
        return parent[node];
    }

    /*
     * Tries to connect the components containing node1 and node2.
     *
     * Returns:
     *
     * true  -> the components were different and were joined
     * false -> the nodes were already connected, creating a cycle
     */
    private boolean union(int node1, int node2) {

        /*
         * IMPORTANT:
         *
         * We must use find(), not parent[node].
         *
         * parent[node] gives only the immediate parent.
         * find(node) gives the final root of the entire component.
         *
         * Example:
         *
         * 4 -> 3 -> 1
         *
         * parent[4] is 3
         * find(4) is 1
         */
        int parent1 = find(node1);
        int parent2 = find(node2);

        /*
         * If both nodes have the same final root,
         * they already belong to the same connected component.
         *
         * That means there is already some path between them.
         *
         * Adding a new edge between them creates a cycle.
         */
        if (parent1 == parent2) {
            return false;
        }

        /*
         * Union by rank:
         *
         * Attach the tree with the smaller rank below the tree
         * with the larger rank.
         *
         * This prevents the DSU tree from becoming unnecessarily tall.
         */
        if (rank[parent1] < rank[parent2]) {

            /*
             * The first component is shorter.
             * Attach its root under parent2.
             *
             * Rank does not increase because the shorter tree is
             * being placed below an already taller tree.
             */
            parent[parent1] = parent2;

        } else if (rank[parent2] < rank[parent1]) {

            /*
             * The second component is shorter.
             * Attach its root under parent1.
             *
             * Rank again does not increase because the overall
             * height of the taller tree remains unchanged.
             */
            parent[parent2] = parent1;

        } else {

            /*
             * Both components have equal rank.
             *
             * We can choose either root as the new leader.
             * Here, parent1 is chosen as the leader.
             */
            parent[parent2] = parent1;

            /*
             * When two trees of equal rank are joined,
             * the resulting tree becomes one level taller.
             *
             * Therefore, increase the rank of the new root.
             */
            rank[parent1]++;
        }

        /*
         * The two different components were successfully joined.
         *
         * No cycle was created, so return true.
         */
        return true;
    }
}
