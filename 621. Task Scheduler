import java.util.*;

class Solution {

    public int leastInterval(char[] tasks, int n) {

        // Stores the frequency of every task.
        // Index 0 represents A, index 1 represents B, and so on.
        int[] charFreq = new int[26];

        // Max Heap stores task frequencies in descending order.
        // This lets us execute the most frequent task first,
        // because frequent tasks are the hardest to schedule.
        PriorityQueue<Integer> maxHeap =
                new PriorityQueue<>((a, b) -> b - a);

        // Count how many times each task appears.
        for (int i = 0; i < tasks.length; i++) {

            // Example:
            // 'A' - 'A' = 0
            // 'B' - 'A' = 1
            charFreq[tasks[i] - 'A']++;
        }

        // Add only existing task frequencies to the Max Heap.
        // Example: A = 3 and B = 3 gives heap [3, 3].
        for (int i = 0; i < 26; i++) {

            if (charFreq[i] > 0) {
                maxHeap.add(charFreq[i]);
            }
        }

        // Stores the total number of intervals.
        // It includes both executed tasks and necessary idle intervals.
        int ans = 0;

        // Continue until every task has been completed.
        // One execution of this loop creates one cycle.
        while (!maxHeap.isEmpty()) {

            // Counts the number of actual tasks executed
            // in the current cycle.
            //
            // Example: A B idle
            // taskCycle = 2 because only two tasks were executed.
            int taskCycle = 0;

            // One cycle contains n + 1 positions.
            //
            // If n = 2, after executing A we need two positions:
            // A _ _
            //
            // Therefore, cycle size = 3.
            int cycle = n + 1;

            // Temporarily stores the remaining frequencies
            // of tasks executed in the current cycle.
            //
            // We do not immediately return them to the heap
            // because the same task must not run again
            // during the current cooldown cycle.
            ArrayList<Integer> list = new ArrayList<>();

            // Fill the current cycle with up to n + 1
            // different available tasks.
            //
            // Stop when either:
            // 1. All cycle positions are used, or
            // 2. No different task is currently available.
            while (cycle > 0 && !maxHeap.isEmpty()) {

                // Remove the task having the highest remaining frequency.
                //
                // If heap contains [3, 2, 1],
                // currTask becomes 3.
                int currTask = maxHeap.poll();

                // We just executed this task once.
                //
                // If currTask was 3, two executions remain.
                // Store 2 temporarily so the task cannot be
                // selected again during this same cycle.
                if (currTask > 1) {
                    list.add(currTask - 1);
                }

                // One actual task was executed.
                taskCycle++;

                // One position from the current cycle was consumed.
                cycle--;
            }

            // The current cycle has finished.
            //
            // Tasks stored in list have completed their cooldown,
            // so they can now become available for the next cycle.
            for (int ele : list) {
                maxHeap.add(ele);
            }

            /*
             * If the heap is empty:
             * All tasks are completed, so count only the actual
             * tasks executed in the final cycle.
             *
             * Example final cycle:
             * A B
             *
             * Count 2, not A B idle, because waiting after
             * all work is completed is unnecessary.
             *
             * If the heap is not empty:
             * More tasks must be executed later, so the complete
             * n + 1 cycle must be counted, including idle positions.
             *
             * Example:
             * A B idle
             *
             * Count all 3 positions because the idle interval is
             * necessary before A or B can execute again.
             */
            if (maxHeap.isEmpty()) {
                ans += taskCycle;
            } else {
                ans += n + 1;
            }
        }

        // Return tasks executed + necessary idle intervals.
        return ans;
    }
}
