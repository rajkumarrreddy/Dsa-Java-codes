class Solution {

    public int[] nextGreaterElement(int[] nums1, int[] nums2) {

        // Length of nums1 and nums2
        int n1 = nums1.length;
        int n2 = nums2.length;

        // If either array is empty, no answer can be generated
        if (n1 == 0 || n2 == 0) {
            return new int[0];
        }

        // Stores:
        // Number -> Next Greater Element
        // Example:
        // 1 -> 3
        // 3 -> 4
        // 4 -> -1
        HashMap<Integer, Integer> map = new HashMap<>();


        // Monotonic Decreasing Stack
        // Stores useful elements from the right side
        Stack<Integer> stack = new Stack<>();


        // Last element has no elements on its right
        // Therefore its Next Greater Element is always -1
        stack.push(nums2[n2 - 1]);
        map.put(nums2[n2 - 1], -1);


        // Start from second-last element and move right -> left
        for (int i = n2 - 2; i >= 0; i--) {

            // Fast path:
            // If current element is smaller than stack top,
            // stack top is immediately its Next Greater Element
            if (stack.peek() > nums2[i]) {

                // Store answer
                map.put(nums2[i], stack.peek());

                // Push current element because it may help
                // elements further to the left
                stack.push(nums2[i]);

                // Skip remaining logic
                continue;
            }


            // Remove all elements smaller than current element
            // because they can never be the Next Greater Element
            while (!stack.isEmpty() && nums2[i] > stack.peek()) {
                stack.pop();
            }


            // After removing useless elements,
            // two situations are possible

            // Situation 1:
            // Stack became empty
            if (stack.isEmpty()) {

                // No greater element exists on the right
                map.put(nums2[i], -1);

                // Push current element so it can help
                // future elements on the left
                stack.push(nums2[i]);
            }

            // Situation 2:
            // Stack still contains something
            else {

                // Top of stack is first greater element
                // on the right side
                map.put(nums2[i], stack.peek());

                // Push current element so it can become
                // the answer for future left elements
                stack.push(nums2[i]);
            }
        }


        // Now map contains all answers
        // Example:
        // {1=3, 3=4, 4=-1, 2=-1}

        // Replace nums1 values with their answers
        for (int i = 0; i < n1; i++) {

            // Find next greater element from map
            nums1[i] = map.get(nums1[i]);
        }

        return nums1;
    }
}
