import java.util.*;

class Solution {

    // LeetCode 56: Merge Intervals
    public int[][] merge(int[][] intervals) {

        // Safety check:
        // If there are no intervals, return an empty 2D array.
        //
        // Without this check, intervals[0] below would cause an error
        // when the input is empty.
        if (intervals == null || intervals.length == 0) {
            return new int[0][];
        }

        /*
         * STEP 1: Sort intervals based on their starting value.
         *
         * a and b represent two intervals.
         *
         * a[0] = starting value of interval a
         * b[0] = starting value of interval b
         *
         * Example before sorting:
         * [[8,10], [1,3], [15,18], [2,6]]
         *
         * After sorting:
         * [[1,3], [2,6], [8,10], [15,18]]
         *
         * Sorting places potentially overlapping intervals
         * next to each other.
         */
        Arrays.sort(
            intervals,
            (a, b) -> Integer.compare(a[0], b[0])
        );

        /*
         * We do not know the final number of intervals.
         *
         * For example:
         * [[1,3], [2,6]] becomes only [[1,6]].
         *
         * Therefore, first store the answer in an ArrayList.
         */
        List<int[]> merged = new ArrayList<>();

        /*
         * prev is the interval that we are currently holding.
         *
         * We do not immediately add it to merged because upcoming
         * intervals may overlap with it.
         *
         * Example:
         * prev = [1,3]
         *
         * If the next interval is [2,6], prev must become [1,6].
         */
        int[] prev = intervals[0];

        /*
         * Start from index 1 because the interval at index 0
         * is already stored in prev.
         */
        for (int i = 1; i < intervals.length; i++) {

            // Store the current interval to make the code readable.
            int[] current = intervals[i];

            /*
             * OVERLAP CONDITION:
             *
             * current[0] = current interval's start
             * prev[1]    = previous interval's end
             *
             * If the current interval starts before or exactly
             * when prev ends, the intervals overlap.
             *
             * Example:
             *
             * prev    = [1,3]
             * current = [2,6]
             *
             * current start <= prev end
             *       2        <=     3
             *
             * Therefore, they overlap.
             */
            if (current[0] <= prev[1]) {

                /*
                 * Merge the intervals by extending prev's ending value.
                 *
                 * Example:
                 *
                 * prev    = [1,3]
                 * current = [2,6]
                 *
                 * New ending value:
                 * max(3,6) = 6
                 *
                 * Therefore:
                 * prev becomes [1,6]
                 *
                 * Math.max() is necessary because current could be
                 * completely inside prev.
                 *
                 * Example:
                 *
                 * prev    = [1,10]
                 * current = [2,6]
                 *
                 * max(10,6) = 10
                 *
                 * So prev correctly remains [1,10].
                 */
                prev[1] = Math.max(prev[1], current[1]);

            } else {

                /*
                 * NO OVERLAP:
                 *
                 * Example:
                 *
                 * prev    = [1,6]
                 * current = [8,10]
                 *
                 * current start > prev end
                 *       8       >     6
                 *
                 * There is a gap, so these intervals cannot be merged.
                 */

                /*
                 * prev is now complete because current does not
                 * overlap with it.
                 *
                 * Add the completed prev interval to the answer.
                 */
                merged.add(prev);

                /*
                 * Now hold the current interval in prev.
                 *
                 * Do not add current immediately because another
                 * upcoming interval may overlap with current.
                 */
                prev = current;
            }
        }

        /*
         * IMPORTANT:
         *
         * This line is OUTSIDE the loop.
         * Therefore, it executes only ONCE after the loop finishes.
         *
         * Why is it needed?
         *
         * When the loop ends, one final interval is still stored
         * inside prev.
         *
         * The final interval has no next interval that can trigger
         * the else block and add it to merged.
         *
         * Example before this line:
         *
         * merged = [[1,6], [8,10]]
         * prev   = [15,18]
         *
         * After this line:
         *
         * merged = [[1,6], [8,10], [15,18]]
         */
        merged.add(prev);

        /*
         * The method must return int[][],
         * but merged is currently List<int[]>.
         *
         * Convert the ArrayList into a 2D integer array.
         */
        return merged.toArray(new int[merged.size()][]);
    }
}
