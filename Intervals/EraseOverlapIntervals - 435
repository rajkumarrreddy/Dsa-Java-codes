import java.util.*;

class Solution {

    public int eraseOverlapIntervals(int[][] intervals) {

        // Edge case:
        // If there are 0 or 1 intervals,
        // nothing needs to be removed.
        if (intervals.length <= 1) {
            return 0;
        }

        // Sort intervals by END TIME.
        //
        // Why?
        // We want to keep intervals that finish earliest
        // because they leave maximum room for future intervals.
        //
        // Example:
        // Before:
        // [[1,100],[2,3],[3,4]]
        //
        // After sorting by end:
        // [[2,3],[3,4],[1,100]]
        Arrays.sort(intervals, (a, b) -> a[1] - b[1]);

        // First interval is always kept.
        int keptIntervals = 1;

        // Store the end time of the last interval we kept.
        int prevEnd = intervals[0][1];

        // Start from the second interval.
        for (int i = 1; i < intervals.length; i++) {

            // Current interval's start and end.
            int currentStart = intervals[i][0];
            int currentEnd = intervals[i][1];

            // Check if current interval overlaps
            // with the previously kept interval.
            //
            // Example:
            //
            // Kept interval:
            // [1,2]
            //
            // Current interval:
            //      [2,3]
            //
            // Since:
            // currentStart >= prevEnd
            // 2 >= 2
            //
            // No overlap.
            if (currentStart >= prevEnd) {

                // Keep this interval.
                keptIntervals++;

                // Update the last kept end time.
                prevEnd = currentEnd;
            }

            // Else overlap exists.
            //
            // Example:
            //
            // Kept interval:
            // [1,3]
            //
            // Current interval:
            //   [2,4]
            //
            // Since:
            // 2 < 3
            //
            // Overlap exists.
            //
            // We SKIP the current interval.
            //
            // Why skip?
            // Because after sorting by end time,
            // the previously kept interval already ends earlier,
            // which is always the better greedy choice.
        }

        // Minimum intervals to remove =
        // Total intervals - Intervals kept
        return intervals.length - keptIntervals;
    }
}
