import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Solution {

    public List<List<Integer>> permuteUnique(int[] nums) {

        // Stores all final unique permutations.
        List<List<Integer>> result = new ArrayList<>();

        // Current permutation being built.
        List<Integer> curr = new ArrayList<>();

        // Sort first so duplicate numbers become adjacent.
        // Example:
        // [1,2,1] -> [1,1,2]
        //
        // This allows us to easily detect duplicates.
        Arrays.sort(nums);

        // used[i] tells us whether nums[i]
        // has already been picked in the current permutation.
        boolean[] used = new boolean[nums.length];

        backtrack(nums, used, curr, result);

        return result;
    }

    private void backtrack(
            int[] nums,
            boolean[] used,
            List<Integer> curr,
            List<List<Integer>> result) {

        // =====================================================
        // BASE CASE
        // =====================================================
        //
        // If current permutation length equals
        // array length, we have chosen every number.
        //
        // Example:
        // curr = [1,2,1]
        //
        // Valid complete permutation found.
        if (curr.size() == nums.length) {

            // Add COPY of current permutation.
            //
            // Don't add curr directly because
            // curr will keep changing during backtracking.
            result.add(new ArrayList<>(curr));

            return;
        }

        // Try every index as the next choice.
        for (int i = 0; i < nums.length; i++) {

            // =====================================================
            // CASE 1: ELEMENT ALREADY USED
            // =====================================================
            //
            // Example:
            // curr = [1]
            //
            // If nums[i] is already inside curr,
            // we cannot reuse it.
            if (used[i]) {
                continue;
            }

            // =====================================================
            // CASE 2: DUPLICATE PRUNING
            // =====================================================
            //
            // Example:
            // nums = [1,1,2]
            //
            // i = 1
            //
            // nums[1] == nums[0]
            //
            // If previous duplicate hasn't been used,
            // then choosing current duplicate creates
            // the exact same branch.
            //
            // So skip it.
            //
            // WHY?
            //
            // BAD:
            // choose second 1 first
            //
            // GOOD:
            // always choose first 1 before second 1
            //
            // This removes duplicate permutations.
            if (i > 0 &&
                nums[i] == nums[i - 1] &&
                !used[i - 1]) {

                continue;
            }

            // =====================================================
            // CHOOSE
            // =====================================================
            //
            // Put nums[i] into current permutation.
            curr.add(nums[i]);

            // Mark that index as used.
            used[i] = true;

            // =====================================================
            // EXPLORE
            // =====================================================
            //
            // Build rest of permutation.
            backtrack(nums, used, curr, result);

            // =====================================================
            // UNDO (BACKTRACK)
            // =====================================================
            //
            // Remove the number we just added.
            //
            // Example:
            // curr = [1,2]
            //
            // remove 2
            // curr = [1]
            curr.remove(curr.size() - 1);

            // Make index available again.
            used[i] = false;
        }
    }
}
