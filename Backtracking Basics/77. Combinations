import java.util.ArrayList;
import java.util.List;

class Solution {

    public List<List<Integer>> combine(int n, int k) {

        /*
         * result stores all completed combinations.
         *
         * For n = 4 and k = 2, result finally becomes:
         * [
         *   [1, 2],
         *   [1, 3],
         *   [1, 4],
         *   [2, 3],
         *   [2, 4],
         *   [3, 4]
         * ]
         */
        List<List<Integer>> result = new ArrayList<>();

        /*
         * current stores the combination we are currently building.
         *
         * It changes during backtracking:
         * []
         * [1]
         * [1, 2]
         * [1]
         * [1, 3]
         * [1]
         * [1, 4]
         * []
         * [2]
         * ...
         */
        List<Integer> current = new ArrayList<>();

        /*
         * Start choosing numbers from 1.
         *
         * start = 1 means:
         * "The next number can be selected starting from 1."
         */
        backtrack(1, n, k, current, result);

        // After backtracking finishes, return all combinations.
        return result;
    }

    private void backtrack(
            int start,
            int n,
            int k,
            List<Integer> current,
            List<List<Integer>> result
    ) {

        /*
         * BASE CASE:
         *
         * If current contains exactly k numbers,
         * we have created one valid combination.
         *
         * Example, when k = 2:
         * current = [1, 2]
         *
         * Its size is 2, so we save it.
         */
        if (current.size() == k) {

            /*
             * Add a COPY of current into result.
             *
             * We need a copy because current will continue changing
             * during backtracking.
             *
             * If we directly add current:
             *
             * result.add(current);
             *
             * all elements inside result would refer to the same
             * changing ArrayList.
             */
            result.add(new ArrayList<>(current));

            /*
             * This combination is complete.
             *
             * We return to the previous recursive call so that
             * it can undo the last choice and try another number.
             */
            return;
        }

        /*
         * Try every available number from start to n.
         *
         * If start = 1 and n = 4:
         * i will be 1, 2, 3, 4.
         *
         * If start = 3 and n = 4:
         * i will only be 3, 4.
         */
        for (int i = start; i <= n; i++) {

            /*
             * STEP 1: CHOOSE
             *
             * Add the current number into the combination.
             *
             * Example:
             * current = [1]
             * i = 2
             *
             * After adding:
             * current = [1, 2]
             */
            current.add(i);

            /*
             * STEP 2: EXPLORE
             *
             * Recursively build the remaining combination.
             *
             * We pass i + 1 because the next choice must come
             * after the number we just selected.
             *
             * If we selected 2, the next call starts from 3.
             *
             * This prevents:
             * [1, 1] because the same number cannot be reused
             * [2, 1] because we cannot move backward
             *
             * Therefore, only unique combinations are produced.
             */
            backtrack(i + 1, n, k, current, result);

            /*
             * STEP 3: UNDO THE CHOICE
             *
             * When the recursive call finishes, control returns here.
             *
             * Remove the number we previously added so that the
             * loop can try the next number.
             *
             * Example:
             * current = [1, 2]
             *
             * Remove the last element:
             * current = [1]
             *
             * Now the loop can try 3:
             * current = [1, 3]
             */
            current.remove(current.size() - 1);
        }
    }
}
