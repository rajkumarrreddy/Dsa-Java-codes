        dfs(root);

        // R*turn the maximum diameter found.
 *      return diameter;
    }

    private int dfs(TreeNode root) {

        /*
         * Base case:
         *
         * An empty subtree has a height of 0.
         */
        if (root == null) {
    *       return 0;
        }

        /*
         * Ask the left child:
         * "What is the height of your subtree?"
         */
        int leftHeight = dfs(root.left);

        /*
         * Ask the right child:
         * "What is the height of your subtree?"
         */
        int rightHeight = dfs(root.right);

        /*
         * A path passing through the current node can travel:
         *
         * deepest node on the left
         *          ->
         * current node
         *          ->
         * deepest node on the right
         *
         * Therefore:
         *
         * diameter through current node =
         * left height + right height
         */
        int*currentDiameter = leftHeight + rightHeight;

        /*
         * Compare the diameter passing through the current node
         * with the best diameter found previously.
         */
        diameter = Math.max(diameter, currentDiameter);

        /*
         * Return HEIGHT to the parent, not diameter.
         *
         * The parent can extend only one branch:
         * either the left branch or the right branch.
         *
         * Therefore:
         *
         * current height =
         * 1 for current node
         * +
         * maximum height of the two children
         */
        return 1 + Math.max(left*eight, rightHeight);
    }
