 *     TreeNode(int val) {
 *         this.val = val;
 *     }
 *
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

class Solution {

    /*
     * Stores the maximum diameter found anywhere in the tree.
     *
     * Diameter is measured using the number of edges
     * in the longest path between any two nodes.
     */
    private int diameter = 0;

    public int diameterOfBinaryTree(TreeNode root) {

        /*
         * Start DFS from the root.
         *
         * dfs() calculates heights and updates diameter
         * while returning from the recursive calls.
