class Solution {

    public List<List<String>> partition(String s) {

        // Stores the current partition path.
        // Example: ["a", "a", "b"]
        List<String> curr = new ArrayList<>();

        // Stores all valid palindrome partitions.
        List<List<String>> res = new ArrayList<>();

        // Start backtracking from index 0.
        bt(s, 0, curr, res);

        return res;
    }

    private void bt(String s,
                    int start,
                    List<String> curr,
                    List<List<String>> res) {

        /*
         * BASE CASE
         *
         * If start reaches the end of the string,
         * it means we have successfully partitioned
         * the entire string.
         *
         * Example:
         * s = "aab"
         *
         * curr = ["aa", "b"]
         *
         * Since start == s.length(),
         * store this partition.
         */
        if (start == s.length()) {
            res.add(new ArrayList<>(curr));
            return;
        }

        /*
         * Try every possible substring
         * starting from 'start'.
         *
         * Example:
         * s = "aab"
         * start = 0
         *
         * end can be:
         * 0 -> "a"
         * 1 -> "aa"
         * 2 -> "aab"
         */
        for (int end = start; end < s.length(); end++) {

            /*
             * Only continue if the substring
             * is a palindrome.
             *
             * Example:
             * "a"  -> valid
             * "aa" -> valid
             * "aab" -> not valid
             */
            if (is(s, start, end)) {

                /*
                 * Extract palindrome substring.
                 *
                 * substring(start, end + 1)
                 * because end index is exclusive.
                 *
                 * Example:
                 * start=0, end=1
                 *
                 * substring(0,2)
                 * -> "aa"
                 */
                String ss = s.substring(start, end + 1);

                /*
                 * Choose
                 *
                 * Add current palindrome
                 * to the current path.
                 */
                curr.add(ss);

                /*
                 * Explore
                 *
                 * Move start to end+1,
                 * because characters up to end
                 * have already been used.
                 *
                 * Example:
                 *
                 * String = "aab"
                 * Chosen = "aa"
                 *
                 * Next recursion starts
                 * from index 2.
                 */
                bt(s, end + 1, curr, res);

                /*
                 * Undo Choice (Backtrack)
                 *
                 * Remove the last substring
                 * so that we can try the next option.
                 *
                 * Example:
                 *
                 * Current = ["aa"]
                 *
                 * After removal:
                 * []
                 *
                 * Now we can try another substring.
                 */
                curr.remove(curr.size() - 1);
            }
        }
    }

    private boolean is(String s, int left, int right) {

        /*
         * Two Pointer Palindrome Check
         *
         * Compare characters from both ends.
         *
         * Example:
         * "racecar"
         *
         * r == r
         * a == a
         * c == c
         *
         * Valid palindrome.
         */
        while (left < right) {

            /*
             * If mismatch found,
             * immediately return false.
             */
            if (s.charAt(left) != s.charAt(right)) {
                return false;
            }

            /*
             * Move inward.
             */
            left++;
            right--;
        }

        /*
         * No mismatch found.
         */
        return true;
    }
}
