class Solution {

    public boolean exist(char[][] board, String word) {

        // Number of rows in the board.
        int rows = board.length;

        // Number of columns in the board.
        int cols = board[0].length;


        /*
         * We do not know where the word starts.
         *
         * Therefore, we treat every cell in the board
         * as a possible starting position.
         */
        for (int row = 0; row < rows; row++) {

            for (int col = 0; col < cols; col++) {

                /*
                 * Start searching from board[row][col].
                 *
                 * index = 0 means we are searching for
                 * the first character of the word.
                 */
                if (backtrack(board, word, row, col, 0)) {

                    // A complete valid path was found.
                    return true;
                }
            }
        }


        /*
         * We tried starting from every cell,
         * but no path formed the complete word.
         */
        return false;
    }


    private boolean backtrack(
        char[][] board,
        String word,
        int row,
        int col,
        int index
    ) {

        /*
         * SUCCESS CONDITION
         *
         * index tells us which character of the word
         * we are currently trying to find.
         *
         * If index becomes equal to word.length(),
         * it means all characters have already been matched.
         *
         * Example:
         *
         * word = "CAT"
         *
         * index 0 -> searching for C
         * index 1 -> searching for A
         * index 2 -> searching for T
         * index 3 -> C, A and T have all been matched
         */
        if (index == word.length()) {
            return true;
        }


        /*
         * FAILURE CONDITION 1: OUTSIDE THE BOARD
         *
         * If the word is not complete, we need a valid
         * board position to continue searching.
         *
         * row < 0:
         * We moved above the board.
         *
         * col < 0:
         * We moved to the left of the board.
         *
         * row >= board.length:
         * We moved below the board.
         *
         * col >= board[0].length:
         * We moved to the right of the board.
         */
        if (
            row < 0 ||
            col < 0 ||
            row >= board.length ||
            col >= board[0].length
        ) {
            return false;
        }


        /*
         * FAILURE CONDITION 2: CHARACTER MISMATCH
         *
         * board[row][col] is the character in the
         * current board cell.
         *
         * word.charAt(index) is the character that
         * we currently need to find.
         *
         * If they are different, this path cannot
         * form the required word.
         *
         * This condition also prevents us from using
         * an already visited cell because visited
         * cells are temporarily changed to '#'.
         */
        if (board[row][col] != word.charAt(index)) {
            return false;
        }


        /*
         * CHOOSE
         *
         * We reached here only when the current cell
         * contains the character we need.
         *
         * Save the original character before changing it.
         * We need this character later to restore the cell.
         */
        char originalCharacter = board[row][col];


        /*
         * Mark the current cell as visited.
         *
         * A cell cannot be used more than once in the
         * same path.
         *
         * We use '#' because it will not match any
         * character that we are searching for.
         */
        board[row][col] = '#';


        /*
         * EXPLORE
         *
         * The current character has been matched.
         *
         * Therefore, search for the next character using:
         *
         * index + 1
         *
         * From the current cell, we can move in four
         * possible directions:
         *
         * Up    -> row - 1
         * Down  -> row + 1
         * Left  -> col - 1
         * Right -> col + 1
         *
         * We use || because finding the remaining word
         * in any one direction is enough.
         */
        boolean found =
            backtrack(
                board,
                word,
                row - 1,
                col,
                index + 1
            ) || // Move up

            backtrack(
                board,
                word,
                row + 1,
                col,
                index + 1
            ) || // Move down

            backtrack(
                board,
                word,
                row,
                col - 1,
                index + 1
            ) || // Move left

            backtrack(
                board,
                word,
                row,
                col + 1,
                index + 1
            ); // Move right


        /*
         * UNDO THE CHOICE / BACKTRACK
         *
         * Restore the original character after exploring
         * all possible directions from this cell.
         *
         * Why restore it?
         *
         * The cell cannot be reused in the current path,
         * but it should be available for other paths.
         *
         * Example:
         *
         * Before choosing:
         * board[row][col] = 'A'
         *
         * While exploring:
         * board[row][col] = '#'
         *
         * After exploring:
         * board[row][col] = 'A'
         */
        board[row][col] = originalCharacter;


        /*
         * Return whether any of the four directions
         * successfully found the remaining characters.
         */
        return found;
    }
}
