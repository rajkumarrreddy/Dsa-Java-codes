/**
 * LeetCode 230: Kth Smallest Element in a BST
 *
 * Key Idea:
 * BST + Inorder Traversal = Nodes visited in sorted order.
 *
 * Example:
 *
 *        5
 *       / \
 *      3   7
 *     / \
 *    2   4
 *
 * Inorder Traversal:
 * 2 -> 3 -> 4 -> 5 -> 7
 *
 * Notice:
 * 1st smallest = 2
 * 2nd smallest = 3
 * 3rd smallest = 4
 *
 * So if we count nodes during inorder traversal,
 * the moment count == k, we have reached the kth smallest node.
 */
class Solution {

    // Keeps track of how many nodes we have visited so far
    private int count = 0;

    // Stores the answer (kth smallest node value)
    private int ans = 0;

    public int kthSmallest(TreeNode root, int k) {

        // Start inorder traversal
        helper(root, k);

        // Return the kth smallest value found
        return ans;
    }

    private void helper(TreeNode root, int k) {

        // Base Case:
        // If node doesn't exist, nothing to process
        if (root == null) {
            return;
        }

        /*
         * STEP 1:
         * Visit the entire left subtree first.
         *
         * Why?
         * Because in a BST, all left subtree values
         * are smaller than the current node.
         */
        helper(root.left, k);

        /*
         * STEP 2:
         * Process the current node.
         *
         * Since inorder visits nodes in sorted order,
         * every time we reach a node, we've found the
         * next smallest element.
         */
        count++;

        /*
         * If this is the kth node visited,
         * we've found the kth smallest element.
         */
        if (count == k) {

            // Store the node's VALUE, not the count
            ans = root.val;

            return;
        }

        /*
         * STEP 3:
         * Visit right subtree.
         *
         * Right subtree contains larger values.
         */
        helper(root.right, k);
    }
}
