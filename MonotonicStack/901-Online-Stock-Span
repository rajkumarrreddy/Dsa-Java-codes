import java.util.Stack;

class StockSpanner {

    // Stack stores:
    // [price, span]
    //
    // Example:
    // [70,2]
    //
    // price = 70
    // span = 2 days
    //
    // Meaning:
    // 70 already knows it covers 2 consecutive days.
    private Stack<int[]> stack;

    // Constructor
    public StockSpanner() {

        // Initially no stock prices have arrived.
        stack = new Stack<>();
    }

    public int next(int price) {

        // Today's day always counts.
        //
        // Example:
        // price = 75
        //
        // At minimum span is 1 (today itself).
        int span = 1;

        // Keep removing all smaller/equal prices.
        //
        // Why?
        //
        // If current price is bigger,
        // those prices can never stop our span.
        //
        // Example:
        //
        // Stack Top:
        // [60,1]
        //
        // Current Price:
        // 70
        //
        // Since 60 <= 70,
        // 70 can cover everything 60 covered.
        while (!stack.isEmpty()
                && stack.peek()[0] <= price) {

            // Remove smaller price.
            //
            // stack.pop() returns:
            // [price, span]
            //
            // Example:
            // [60,1]
            //
            // Index [1] means span.
            //
            // Therefore:
            //
            // span += 1
            //
            // We "steal" the previously calculated span
            // instead of counting again.
            span += stack.pop()[1];
        }

        // Store current price with its total span.
        //
        // Example:
        //
        // price = 75
        // span = 4
        //
        // Store:
        // [75,4]
        //
        // Meaning:
        // 75 already knows it covers 4 days.
        stack.push(new int[]{price, span});

        // Return today's answer.
        return span;
    }
}
