import java.util.Arrays;

class Solution {

    public int findTheCity(
        int n,
        int[][] edges,
        int distanceThreshold
    ) {

        /*
         * dist[i][j] represents the shortest known distance
         * from city i to city j.
         *
         * Example:
         * dist[0][2] = shortest distance from city 0 to city 2.
         */
        int[][] dist = new int[n][n];

        /*
         * INF represents that no path is currently known.
         *
         * We avoid Integer.MAX_VALUE because Floyd-Warshall adds
         * two distances:
         *
         * dist[source][via] + dist[via][destination]
         *
         * Adding something to Integer.MAX_VALUE can overflow.
         */
        int INF = 1_000_000_000;

        /*
         * Initialize the distance matrix.
         */
        for (int city = 0; city < n; city++) {

            /*
             * Initially, assume this city cannot reach any city.
             *
             * If n = 4, this makes the current row:
             *
             * [INF, INF, INF, INF]
             */
            Arrays.fill(dist[city], INF);

            /*
             * A city requires zero distance to reach itself.
             *
             * dist[0][0] = 0
             * dist[1][1] = 0
             * dist[2][2] = 0
             * ...
             */
            dist[city][city] = 0;
        }

        /*
         * Add the directly connected roads to the matrix.
         *
         * Every edge has this format:
         *
         * [from, to, weight]
         */
        for (int[] edge : edges) {

            int from = edge[0];
            int to = edge[1];
            int weight = edge[2];

            /*
             * The road is bidirectional.
             *
             * If city 0 and city 1 are connected with weight 3:
             *
             * 0 -> 1 = 3
             * 1 -> 0 = 3
             */
            dist[from][to] = weight;
            dist[to][from] = weight;
        }

        /*
         * Run Floyd-Warshall.
         *
         * Floyd-Warshall calculates the shortest distance
         * between every pair of cities.
         */
        for (int via = 0; via < n; via++) {

            /*
             * Try every city as the starting city.
             */
            for (int source = 0; source < n; source++) {

                /*
                 * Try every city as the destination.
                 */
                for (int destination = 0;
                     destination < n;
                     destination++) {

                    /*
                     * Compare two routes:
                     *
                     * 1. Existing route:
                     *
                     *    source -> destination
                     *
                     *    dist[source][destination]
                     *
                     *
                     * 2. Route through the intermediate city:
                     *
                     *    source -> via -> destination
                     *
                     *    dist[source][via]
                     *             +
                     *    dist[via][destination]
                     *
                     *
                     * Keep whichever route is shorter.
                     *
                     * Math.min() is essential here.
                     * Without it, a shorter distance could be
                     * overwritten by a longer distance.
                     */
                    dist[source][destination] = Math.min(
                        dist[source][destination],
                        dist[source][via]
                            + dist[via][destination]
                    );
                }
            }
        }

        /*
         * Stores the city that should be returned.
         *
         * -1 means no city has been selected yet.
         */
        int answerCity = -1;

        /*
         * Stores the smallest reachable-city count found so far.
         *
         * Start with the largest possible integer so the first
         * city's count will always be accepted.
         */
        int minimumReachableCount = Integer.MAX_VALUE;

        /*
         * Check every city individually.
         */
        for (int city = 0; city < n; city++) {

            /*
             * Count how many other cities the current city
             * can reach within distanceThreshold.
             *
             * The count starts at zero for every new city.
             */
            int reachableCount = 0;

            /*
             * Check every possible neighboring city.
             */
            for (int neighbor = 0; neighbor < n; neighbor++) {

                /*
                 * Count this neighbor only when:
                 *
                 * 1. It is not the current city itself.
                 *
                 * 2. Its shortest distance from the current city
                 *    is less than or equal to distanceThreshold.
                 */
                if (
                    city != neighbor &&
                    dist[city][neighbor] <= distanceThreshold
                ) {
                    reachableCount++;
                }
            }

            /*
             * We want the city with the smallest number of
             * reachable cities.
             *
             * We use <= instead of < to handle ties.
             *
             * Cities are processed in increasing order:
             *
             * 0, 1, 2, 3, ...
             *
             * When two cities have the same reachable count,
             * <= allows the later city to replace the earlier one.
             *
             * The later city has the larger city number, which
             * is exactly what the problem requires.
             */
            if (reachableCount <= minimumReachableCount) {

                // Save the new smallest count.
                minimumReachableCount = reachableCount;

                // Save the corresponding city.
                answerCity = city;
            }
        }

        /*
         * Return the city with:
         *
         * 1. The smallest number of reachable cities.
         * 2. The greatest city number if there is a tie.
         */
        return answerCity;
    }
}
