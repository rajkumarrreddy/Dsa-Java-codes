import java.util.*;

class Solution {

    public int orangesRotting(int[][] grid) {

        /*
         * Queue stores the positions of rotten oranges.
         *
         * Each int[] contains:
         * index 0 -> row
         * index 1 -> column
         *
         * Example:
         * new int[] {1, 2} represents grid[1][2].
         */
        Queue<int[]> queue = new LinkedList<>();

        // Tracks how many fresh oranges are still remaining.
        int fresh = 0;


        /*
         * STEP 1: Scan the complete grid.
         *
         * 1. Add every initially rotten orange to the queue.
         * 2. Count the total number of fresh oranges.
         *
         * We add ALL rotten oranges because they spread rotting
         * simultaneously. This is called multi-source BFS.
         */
        for (int row = 0; row < grid.length; row++) {

            for (int col = 0; col < grid[0].length; col++) {

                // 2 represents a rotten orange.
                if (grid[row][col] == 2) {

                    // Store the rotten orange's position.
                    queue.offer(new int[] { row, col });
                }

                // 1 represents a fresh orange.
                else if (grid[row][col] == 1) {

                    fresh++;
                }
            }
        }


        /*
         * If there are no fresh oranges initially,
         * zero minutes are required.
         */
        if (fresh == 0) {
            return 0;
        }


        // Stores the number of minutes required.
        int minutes = 0;


        /*
         * These are the four possible directions from a cell.
         *
         * { 1, 0 }  -> Down
         * {-1, 0 }  -> Up
         * { 0, 1 }  -> Right
         * { 0,-1 }  -> Left
         *
         * The first value changes the row.
         * The second value changes the column.
         */
        int[][] directions = {
            { 1, 0 },
            {-1, 0 },
            { 0, 1 },
            { 0,-1 }
        };


        /*
         * STEP 2: Start multi-source BFS.
         *
         * Continue while rotten oranges are available
         * to process in the queue.
         */
        while (!queue.isEmpty()) {

            /*
             * queue.size() gives the number of oranges that were
             * rotten at the BEGINNING of this minute.
             *
             * We process exactly these oranges in this BFS level.
             *
             * Any newly rotten oranges are added to the queue,
             * but they spread rotting during the NEXT minute.
             */
            int size = queue.size();

            /*
             * Tracks whether at least one fresh orange became
             * rotten during this minute.
             *
             * We increase minutes only when actual rotting happens.
             */
            boolean rottenThisMinute = false;


            // Process one complete BFS level, meaning one minute.
            for (int i = 0; i < size; i++) {

                /*
                 * Remove the next rotten orange from the queue.
                 */
                int[] current = queue.poll();

                // Extract its row and column.
                int row = current[0];
                int col = current[1];


                /*
                 * Check all four neighboring cells:
                 * down, up, right and left.
                 */
                for (int[] dir : directions) {

                    /*
                     * Calculate the neighboring cell's position.
                     *
                     * Current position + direction
                     * gives the neighboring position.
                     */
                    int newRow = row + dir[0];
                    int newCol = col + dir[1];


                    /*
                     * Skip this neighbor if:
                     *
                     * 1. newRow is above the grid.
                     * 2. newCol is left of the grid.
                     * 3. newRow is below the grid.
                     * 4. newCol is right of the grid.
                     * 5. The neighboring cell is not a fresh orange.
                     *
                     * Important:
                     * Check newRow and newCol because those represent
                     * the neighbor we are about to access.
                     */
                    if (newRow < 0 ||
                        newCol < 0 ||
                        newRow >= grid.length ||
                        newCol >= grid[0].length ||
                        grid[newRow][newCol] != 1) {

                        // Move to the next direction.
                        continue;
                    }


                    /*
                     * We reach here only when the neighboring cell
                     * is inside the grid and contains a fresh orange.
                     *
                     * Convert the fresh orange into a rotten orange.
                     *
                     * Marking it immediately prevents another rotten
                     * orange from adding the same cell again.
                     */
                    grid[newRow][newCol] = 2;


                    // One fewer fresh orange now remains.
                    fresh--;


                    /*
                     * Add the newly rotten orange to the queue.
                     *
                     * This orange can spread rotting to its neighbors
                     * during the next BFS level, meaning next minute.
                     */
                    queue.offer(new int[] { newRow, newCol });


                    // At least one orange became rotten this minute.
                    rottenThisMinute = true;
                }
            }


            /*
             * Increase time only if at least one fresh orange
             * became rotten during this BFS level.
             *
             * This prevents us from counting an unnecessary final
             * minute when the remaining queue elements cannot rot
             * anything new.
             */
            if (rottenThisMinute) {
                minutes++;
            }
        }


        /*
         * If fresh == 0:
         * Every fresh orange became rotten, so return the time.
         *
         * If fresh > 0:
         * Some fresh oranges were unreachable, so return -1.
         *
         * Same as:
         *
         * if (fresh == 0) {
         *     return minutes;
         * } else {
         *     return -1;
         * }
         */
        return fresh == 0 ? minutes : -1;
    }
}
