class Solution {

    public int numIslands(char[][] grid) {

        // This variable stores how many separate islands we discover.
        //
        // Important:
        // We count islands, not individual land cells.
        int islands = 0;

        // Scan every row in the grid.
        for (int row = 0; row < grid.length; row++) {

            // For the current row, scan every column.
            for (int col = 0; col < grid[0].length; col++) {

                // '1' means land that has not been visited yet.
                //
                // If we find an unvisited land cell, it means we have
                // discovered the first cell of a new island.
                if (grid[row][col] == '1') {

                    // Count the newly discovered island.
                    //
                    // We increment only once here. DFS will visit all
                    // other connected land cells of the same island,
                    // so those cells must not be counted separately.
                    islands++;

                    // Starting from this land cell, visit every land cell
                    // connected horizontally or vertically to it.
                    //
                    // DFS will change all cells of this island from
                    // '1' to '0', marking the complete island as visited.
                    dfs(grid, row, col);
                }
            }
        }

        // After scanning the complete grid, return the number
        // of separate islands that were discovered.
        return islands;
    }

    private void dfs(char[][] grid, int row, int col) {

        // Stop the current DFS call if it reaches an invalid position.
        //
        // These conditions must come before grid[row][col] because
        // accessing an invalid row or column would cause an
        // ArrayIndexOutOfBoundsException.
        if (
            // We moved above the grid.
            row < 0 ||

            // We moved outside the left boundary.
            col < 0 ||

            // We moved below the final row.
            //
            // For 3 rows, valid indexes are 0, 1 and 2.
            // Therefore, row 3 is invalid.
            row >= grid.length ||

            // We moved beyond the final column.
            //
            // grid[0].length gives the number of columns.
            col >= grid[0].length ||

            // The current cell is water or has already been visited.
            //
            // This is char[][], so we must compare with the character
            // '0', not the integer 0.
            grid[row][col] == '0'
        ) {
            // Stop only this invalid recursive direction.
            //
            // Control returns to the previous paused DFS call,
            // which will then try its next direction.
            return;
        }

        // We reached valid unvisited land.
        //
        // Change '1' to '0' to mark this cell as visited.
        // This prevents DFS from repeatedly moving between the same cells
        // and causing infinite recursion or StackOverflowError.
        grid[row][col] = '0';

        // Explore the cell above.
        //
        // Row decreases by 1.
        // Column remains unchanged.
        dfs(grid, row - 1, col);

        // Explore the cell below.
        //
        // Row increases by 1.
        // Column remains unchanged.
        dfs(grid, row + 1, col);

        // Explore the cell to the right.
        //
        // Row remains unchanged.
        // Column increases by 1.
        dfs(grid, row, col + 1);

        // Explore the cell to the left.
        //
        // Row remains unchanged.
        // Column decreases by 1.
        dfs(grid, row, col - 1);
    }
}
